NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000

# Comma-free single origin, or * to allow any client
CORS_ORIGIN=*

# Either set DATABASE_URL (managed providers) or the discrete DB_* values below.
# DATABASE_URL=postgresql://user:password@host:5432/malamai
DB_HOST=localhost
DB_PORT=5432
DB_NAME=malamai
DB_USER=postgres
DB_PASSWORD=change-me
# Defaults to on when DATABASE_URL is set, off otherwise
DB_SSL=false
DB_POOL_MAX=10

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Seeded on first boot
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_SECRET_KEY=
