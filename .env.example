NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000

# Pin this to your app origin in production (do not leave as *)
CORS_ORIGIN=*

# Either set DATABASE_URL (managed providers) or the discrete DB_* values below.
# DATABASE_URL=postgresql://user:password@host:5432/malamai
DB_HOST=localhost
DB_PORT=5432
DB_NAME=malamai
DB_USER=postgres
DB_PASSWORD=change-me
# Defaults to on when DATABASE_URL is set, off otherwise
DB_SSL=false
DB_POOL_MAX=10

# Required. Generate with: openssl rand -hex 32
# Production refuses to start if this is missing, short, or a placeholder.
JWT_SECRET=change-me
# Prefer a short-lived access token; default is 12h if unset
JWT_EXPIRES_IN=12h

EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Required in production to seed the first admin (password min 12 chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Optional break-glass key for automation. Must be >= 32 chars.
# In production also set ALLOW_ADMIN_SECRET_KEY=true to enable it.
ADMIN_SECRET_KEY=
# ALLOW_ADMIN_SECRET_KEY=false

# ── AI Provider Keys ─────────────────────────────────────────────────────────
# Primary: Groq — get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# Override the primary model (optional — defaults to llama-3.3-70b-versatile)
# GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile

# Fallback: Gemini — used only when all Groq models are quota-exhausted
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# ── AI Rate Limits ────────────────────────────────────────────────────────────
# Max AI messages per user per day (defaults below)
AI_DAILY_CHAT_LIMIT=30
AI_DAILY_GENERATE_LIMIT=20
# How many days to keep cached AI responses (default 7)
AI_CACHE_TTL_DAYS=7
